#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        //zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_adjust_layer {
            bindings = <&mo 3>;
            key-positions = <37 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
                         &kp LALT  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp MINUS
            >;
        };

        lower_layer {
            label = "RAISE";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESC    &kp N1    &kp N2   &kp N3    &kp N4    &kp N5       &kp N6             &kp N7     &kp N8     &kp N9    &kp N0    &kp EQUAL
&kp LGUI   &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET          &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR  &kp GRAVE
&kp LSHFT  &kp F13   &kp F14  &kp F15   &kp F16   &kp LBKT     &kp RIGHT_BRACKET  &kp MINUS  &kp EQUAL  &none     &none     &none
                              &kp LALT  &mo 1     &kp SPACE    &kp ENTER          &mo 3      &none
            >;
        };

        raise_layer {
            label = "LOWER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp F1     &kp F2     &kp F3           &kp F4      &kp F5    &kp F6       &kp F7        &kp F8    &kp F9    &kp F10  &kp F11    &kp F12
&kp GRAVE  &kp TILDE  &kp PRINTSCREEN  &kp INS     &kp HOME  &kp PG_UP    &none         &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &none
&kp LSHFT  &none      &none            &kp DELETE  &kp END   &kp PG_DN    &kp KP_SLASH  &none     &none     &none    &none      &none
                                       &kp LALT    &mo 3     &kp SPACE    &kp ENTER     &mo 2     &none
            >;
        };

        adjust_layer {
            label = "ADJUST";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp K_COFFEE   &none           &none  &none     &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3       &none  &kp C_PLAY_PAUSE  &kp C_BRIGHTNESS_MAXIMUM  &kp C_MUTE
&bt BT_CLR     &kp LG(LC(D))   &none  &none     &kp LG(LS(LEFT))  &none           &none         &kp LG(LS(RIGHT))  &none  &kp C_NEXT        &kp C_BRIGHTNESS_INC      &kp C_VOLUME_UP
&kp LC(LS(T))  &kp LG(LC(F4))  &none  &none     &kp LC(LS(TAB))   &none           &none         &kp LC(TAB)        &none  &kp C_PREVIOUS    &kp C_BRIGHTNESS_DEC      &kp C_VOLUME_DOWN
                                      &kp LALT  &mo 3             &kp SPACE       &kp RET       &mo 3              &none
            >;
        };
    };
};
